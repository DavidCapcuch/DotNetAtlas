{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft": "Warning",
        "MassTransit": "Information"
      }
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Saga": "Data Source=127.0.0.1,12345;Initial Catalog=Weather;Persist Security Info=False;User ID=sa;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Encrypt=True;TrustServerCertificate=True"
  },
  "EfCore": {
    "DbContextPoolSize": 10,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  "Saga": {
    "SubscriptionTimeouts": {
      "PaymentMinutes": 10,
      "ActivationMinutes": 5,
      "CompensationMinutes": 30
    },
    "PaymentTimeouts": {
      "AuthorizationMinutes": 5,
      "CaptureMinutes": 5,
      "VoidMinutes": 5,
      "ActivationMinutes": 5,
      "RefundMinutes": 30
    },
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 5,
    "ConcurrencyLimit": 10,
    "KafkaBootstrapServers": "localhost:9094",
    "SchemaRegistryUrl": "http://localhost:8081",
    "Topics": {
      "OrderAlertSubscriptions": "order.alert-subscriptions",
      "WeatherAlerts": "weather.alerts",
      "FinancePayments": "finance.payments",
      "FinancePaymentCommands": "finance.payment-commands",
      "WeatherAlertsCommands": "weather.alerts.commands"
    },
    "ConsumerGroup": "saga-orchestrator"
  },
  "SagaHealthCheck": {
    "StuckSagaThresholdMinutes": 30,
    "MaxStuckSagasBeforeDegraded": 5,
    "MaxStuckSagasBeforeUnhealthy": 20
  },
  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "KafkaTimeout": "00:00:05"
  }
}

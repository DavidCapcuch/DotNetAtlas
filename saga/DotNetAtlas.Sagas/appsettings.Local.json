{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "MassTransit": "Debug",
        "System": "Information"
      }
    }
  },
  // Infrastructure layer
  // Communication & Messaging
  "Kafka": {
    "AvroSerializer": {
      "AutoRegisterSchemas": true
    }
  },
  "EfCore": {
    "EnableDetailedErrors": true
  }
}

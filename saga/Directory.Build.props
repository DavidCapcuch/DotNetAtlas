<Project>
    <!-- Import root Directory.Build.props first -->
    <PropertyGroup>
        <RootBuildPropsPath>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</RootBuildPropsPath>
    </PropertyGroup>
    <Import Project="$(RootBuildPropsPath)" Condition="Exists('$(RootBuildPropsPath)')"/>

    <!-- Import test-specific configuration for test projects -->
    <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.UnitTests')) OR $(MSBuildProjectName.EndsWith('.IntegrationTests'))">
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <SonarQubeTestProject>true</SonarQubeTestProject>
        <CoverletOutput>$(MSBuildProjectDirectory)/TestResults/</CoverletOutput>
    </PropertyGroup>

    <!-- Shared test configuration files for test projects -->
    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.UnitTests')) OR $(MSBuildProjectName.EndsWith('.IntegrationTests'))">
        <Content Include="$(MSBuildThisFileDirectory)..\test\xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="$(MSBuildThisFileDirectory)..\test\coverlet.runsettings" Link="coverlet.runsettings" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!-- Common usings for test projects -->
    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.UnitTests')) OR $(MSBuildProjectName.EndsWith('.IntegrationTests'))">
        <Using Include="Xunit"/>
        <Using Include="AwesomeAssertions"/>
        <Using Include="AwesomeAssertions.Execution"/>
    </ItemGroup>

    <!-- Common test packages for all test projects -->
    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.UnitTests')) OR $(MSBuildProjectName.EndsWith('.IntegrationTests'))">
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="AwesomeAssertions"/>
        <PackageReference Include="AwesomeAssertions.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Suppress VSTHRD200 (Async suffix) and xUnit1051 (CancellationToken) for test projects only -->
    <!-- xUnit1051 is suppressed because MassTransit test harness methods don't always expose CancellationToken -->
    <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.UnitTests')) OR $(MSBuildProjectName.EndsWith('.IntegrationTests'))">
        <NoWarn>$(NoWarn);VSTHRD200;xUnit1051</NoWarn>
    </PropertyGroup>
</Project>

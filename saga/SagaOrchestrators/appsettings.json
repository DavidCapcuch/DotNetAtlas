{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft": "Warning",
        "MassTransit": "Information"
      }
    }
  },
  "OTEL_SERVICE_NAME": "SagaOrchestrators",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  // Kestrel:Endpoints wins over HTTP_PORTS from the chiseled base image and silences
  // the "Overriding HTTP_PORTS '8080'" startup warning.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  },
  // Feature flags (ADR-0014). Opt-in via Platform.ServiceDefaults.AddFeatureFlags(IConfiguration);
  // relative path resolves against the service content root.
  "FeatureFlags": {
    "FilePath": "flags.json"
  },
  // Connection strings for cross-BC consumption:
  // - Redis:Basket (ADR-0016): Basket BC primary aggregate store (AOF, noeviction).
  // - Redis:Cache  (ADR-0013 + ADR-0016): ASP.NET OutputCache backing for FastEndpoints .Idempotency()
  //   — read by Platform.ServiceDefaults.AddIdempotencyKeyOutputCache.
  // - AzureStorage (ADR-0017): Azurite dev emulator; Invoicing BC consumes via Azure.Storage.Blobs.
  "ConnectionStrings": {
    "Saga": "Host=127.0.0.1;Port=5433;Database=Saga;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true",
    "Redis:Basket": "redis-basket:6379",
    "Redis:Cache": "redis-cache:6379",
    "AzureStorage": "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
  },
  "EfCore": {
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  "Saga": {
    "PaymentProcessingTimeouts": {
      "AuthorizationMinutes": 5,
      "CaptureApprovalMinutes": 5,
      "CaptureMinutes": 5,
      "VoidMinutes": 5
    },
    "CheckoutTimeouts": {
      "OrderCreationSeconds": 30,
      "StockReservationSeconds": 60,
      "PaymentSeconds": 90,
      "OrderConfirmationSeconds": 30,
      "CompensationSeconds": 300
    },
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 5,
    "ConcurrencyLimit": 10
  },
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    },
    "Topics": {
      "PaymentsTransactions": "payments.transactions",
      "PaymentsPaymentCommands": "payments.payment-commands",
      "BasketSessions": "basket.sessions",
      "OrderingOrders": "ordering.orders",
      "InventoryReservations": "inventory.reservations",
      "OrderingOrderCommands": "ordering.order-commands",
      "InventoryReservationCommands": "inventory.reservation-commands",
      "CheckoutSagas": "checkout.sagas"
    },
    "ConsumerGroups": {
      "PaymentProcessingSaga": "saga-payment-processing",
      "CheckoutSaga": "saga-checkout"
    },
    "AvroDeserializer": {
      "SubjectNameStrategy": "Record",
      "UseLatestVersion": false
    }
  },
  "SagaHealthCheck": {
    "StuckSagaThresholdMinutes": 30,
    "MaxStuckSagasBeforeDegraded": 5,
    "MaxStuckSagasBeforeUnhealthy": 20
  },
  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "KafkaTimeout": "00:00:05"
  }
}

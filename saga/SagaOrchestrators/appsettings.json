{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft": "Warning",
        "MassTransit": "Information"
      }
    }
  },
  "OTEL_SERVICE_NAME": "SagaOrchestrators",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  // Kestrel endpoint binding — canonical config so HTTP_PORTS (set by the chiseled
  // base image) and ASPNETCORE_URLS (removed from Dockerfile/compose) no longer
  // race. Kestrel:Endpoints takes precedence and silences the
  // "Overriding HTTP_PORTS '8080'" startup warning.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  },
  // Feature flags (ADR-0014). Opt-in via Platform.ServiceDefaults.AddFeatureFlags(IConfiguration);
  // relative path resolves against the service content root. Wave 0 M7: seed only, opt-in is Wave 2 saga decision.
  "FeatureFlags": {
    "FilePath": "flags.json"
  },
  // No ServiceAuth section: the saga has no inbound HTTP surface and publishes commands via
  // Kafka, not HTTP (service-scope-matrix.md §2/§3, ADR-0004 Implementation Notes). The
  // `checkout-saga` Keycloak realm client + its 12 `*.commands.*` scopes are kept so the v2
  // production posture can wire **broker-level Kafka SASL/OAUTHBEARER + topic ACLs**
  // (ADR-0010 §Implementation Notes "Kafka command-topic authorization", ADR-0009 production
  // callout). When that lands it reads broker credentials from `Confluent.Kafka` Sasl* config
  // keys — NOT from `Platform.ServiceDefaults.ServiceAuthOptions` / `AddServiceAuth(...)`,
  // which is an HTTP-only handler. Add the Sasl* config block then; don't pre-provision now.
  // Wave 0 M7: Redis:Basket / Redis:Cache / AzureStorage seeded ahead of Wave 2 consumption.
  // - Redis:Basket (ADR-0016): Basket BC primary aggregate store (AOF, noeviction).
  // - Redis:Cache  (ADR-0013 + ADR-0016): ASP.NET OutputCache backing for FastEndpoints .Idempotency()
  //   — read by Platform.ServiceDefaults.AddIdempotencyKeyOutputCache.
  // - AzureStorage (ADR-0017): Azurite dev emulator; Invoicing BC consumes via Azure.Storage.Blobs.
  "ConnectionStrings": {
    "Saga": "Host=127.0.0.1;Port=5433;Database=Weather;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true",
    "Redis:Basket": "redis-basket:6379",
    "Redis:Cache": "redis-cache:6379",
    "AzureStorage": "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
  },
  "EfCore": {
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  "Saga": {
    "PaymentProcessingTimeouts": {
      "AuthorizationMinutes": 5,
      "CaptureMinutes": 5,
      "VoidMinutes": 5,
      "RefundMinutes": 30,
      "SuccessFinalizationMinutes": 60
    },
    "CheckoutTimeouts": {
      "OrderCreationSeconds": 30,
      "StockReservationSeconds": 60,
      "PaymentSeconds": 90,
      "OrderConfirmationSeconds": 30,
      "CompensationSeconds": 300
    },
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 5,
    "ConcurrencyLimit": 10
  },
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    },
    "Topics": {
      "WeatherAlertSubscriptions": "weather.alert-subscriptions",
      "WeatherAlertSubscriptionsCommands": "weather.alert-subscriptions.commands",
      // Topic value is Payments BC's canonical event-log topic (payments.transactions).
      // Per docs/kafka-topology.md and services/Payments/Payments.Application/Common/Messaging/TopicsOptions.cs,
      // Payments produces PaymentAuthorized/Captured/Voided/Refunded events to payments.transactions; the saga
      // consumes them here.
      "PaymentsTransactions": "payments.transactions",
      "PaymentsPaymentCommands": "payments.payment-commands",
      "BasketSessions": "basket.sessions",
      "OrderingOrders": "ordering.orders",
      "InventoryReservations": "inventory.reservations",
      "OrderingOrderCommands": "ordering.order-commands",
      "InventoryReservationCommands": "inventory.reservation-commands",
      "CheckoutSagas": "checkout.sagas"
    },
    "ConsumerGroups": {
      "PaymentProcessingSaga": "saga-payment-processing",
      "CheckoutSaga": "saga-checkout"
    },
    "AvroDeserializer": {
      "SubjectNameStrategy": "Record",
      "UseLatestVersion": false
    }
  },
  "SagaHealthCheck": {
    "StuckSagaThresholdMinutes": 30,
    "MaxStuckSagasBeforeDegraded": 5,
    "MaxStuckSagasBeforeUnhealthy": 20
  },
  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "KafkaTimeout": "00:00:05"
  }
}

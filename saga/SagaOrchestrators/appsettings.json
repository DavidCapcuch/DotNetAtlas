{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft": "Warning",
        "MassTransit": "Information"
      }
    }
  },
  "OTEL_SERVICE_NAME": "SagaOrchestrators",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "AllowedHosts": "*",
  // Feature flags (ADR-0014). Opt-in via Platform.ServiceDefaults.AddFeatureFlags(IConfiguration);
  // relative path resolves against the service content root. Wave 0 M7: seed only, opt-in is Wave 2 saga decision.
  "FeatureFlags": {
    "FilePath": "flags.json"
  },
  // Service-to-service auth (ADR-0010, service-scope-matrix.md §2 "checkout-saga").
  // Opt-in via Platform.ServiceDefaults.AddServiceAuth("checkout-saga"). Wave 0 M7: seed only.
  //
  // ClientSecret is deliberately empty here. The .NET IConfiguration binding reads it from env var
  // `ServiceAuth__ClientSecret` at runtime (standard double-underscore convention). Matrix §4
  // documents `KEYCLOAK__SERVICE_CLIENT_SECRET__CHECKOUT_SAGA` as the aspirational logical env-var
  // the deployment / compose environment / vault should map to `ServiceAuth__ClientSecret`.
  // A platform-level `PostConfigureOptions<ServiceAuthOptions>` bridge projecting
  // `Keycloak:ServiceClientSecret:<SERVICE>` → `ServiceAuth:ClientSecret` is deferred to Wave 1
  // when the first BC invokes AddServiceAuth().
  //
  // Authority uses host-port localhost:9011 because this service runs via `dotnet run` locally,
  // not inside docker-compose. A future compose-hosted saga would switch to http://keycloak:8080.
  "ServiceAuth": {
    "Authority": "http://localhost:9011/realms/dotnetatlas",
    "ClientId": "checkout-saga",
    "ServiceName": "checkout-saga",
    "ClientSecret": ""
  },
  // Wave 0 M7: Redis:Basket / Redis:Cache / AzureStorage seeded ahead of Wave 2 consumption.
  // - Redis:Basket (ADR-0016): Basket BC primary aggregate store (AOF, noeviction).
  // - Redis:Cache  (ADR-0013 + ADR-0016): ASP.NET OutputCache backing for FastEndpoints .Idempotency()
  //   — read by Platform.ServiceDefaults.AddIdempotencyKeyOutputCache.
  // - AzureStorage (ADR-0017): Azurite dev emulator; Invoicing BC consumes via Azure.Storage.Blobs.
  "ConnectionStrings": {
    "Saga": "Host=127.0.0.1;Port=5433;Database=Weather;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true",
    "Redis:Basket": "redis-basket:6379",
    "Redis:Cache": "redis-cache:6379",
    "AzureStorage": "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
  },
  "EfCore": {
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  "Saga": {
    "PaymentProcessingTimeouts": {
      "AuthorizationMinutes": 5,
      "CaptureMinutes": 5,
      "VoidMinutes": 5,
      "RefundMinutes": 30,
      "SuccessFinalizationMinutes": 60
    },
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 5,
    "ConcurrencyLimit": 10
  },
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    },
    "Topics": {
      "WeatherAlertSubscriptions": "weather.alert-subscriptions",
      "WeatherAlertSubscriptionsCommands": "weather.alert-subscriptions.commands",
      "PaymentsPayments": "payments.payments",
      "PaymentsPaymentCommands": "payments.payment-commands"
    },
    "ConsumerGroups": {
      "PaymentProcessingSaga": "saga-payment-processing"
    },
    "AvroDeserializer": {
      "SubjectNameStrategy": "Record",
      "UseLatestVersion": false
    }
  },
  "SagaHealthCheck": {
    "StuckSagaThresholdMinutes": 30,
    "MaxStuckSagasBeforeDegraded": 5,
    "MaxStuckSagasBeforeUnhealthy": 20
  },
  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "KafkaTimeout": "00:00:05"
  }
}

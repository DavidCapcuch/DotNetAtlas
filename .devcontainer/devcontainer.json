{
  "name": "DotNetAtlas Development Environment",
  // Use root docker-compose.yaml to avoid service duplication
  "dockerComposeFile": [
    "devcontainer-docker-compose.yaml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // Required features for development
  "features": {
    // Docker-in-Docker for container development (docker-compose, etc.)
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "v2",
      "moby": true,
      "azureDnsAutoDetection": true
    },
    // PowerShell for scripting (test scripts, build scripts)
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "latest"
    },
    // GitHub CLI for repository management
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    // Node.js for frontend tooling if needed
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  // Resource requirements sized for the full multi-BC stack under `--profile full`
  // (Postgres, Kafka, Keycloak, the 7 BC APIs + outbox relays, observability).
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb"
  },
  // Lifecycle commands
  // Note: dotnet restore is handled in post-create.sh to avoid redundancy
  "postCreateCommand": ".devcontainer/post-create.sh",
  "postStartCommand": "dotnet dev-certs https --trust 2>/dev/null || true",
  "postAttachCommand": ".devcontainer/post-attach.sh",
  // Container user
  "remoteUser": "vscode",
  // Environment variables
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "ASPNETCORE_ENVIRONMENT": "Development"
  },
  // VS Code customizations
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-azuretools.vscode-containers",
        "GitHub.vscode-pull-request-github",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-azuretools.vscode-azure-github-copilot",
        "SonarSource.sonarlint-vscode",
        "streetsidesoftware.code-spell-checker",
        "ms-ossdata.vscode-pgsql",
        "mhutchie.git-graph",
        "eamodio.gitlens",
        "EditorConfig.EditorConfig",
        "redhat.vscode-yaml",
        "ms-vscode.powershell",
        "formulahendry.dotnet-test-explorer",
        "alefragnani.project-manager",
        "tomaszbartoszewski.avro-tools",
        "waderyan.gitblame",
        "DavidAnson.vscode-markdownlint",
        "Redis.redis-for-vscode",
        "usernamehw.errorlens"
      ],
      "settings": {
        // Port forwarding settings
        "remote.autoForwardPorts": true,
        "remote.autoForwardPortsSource": "output",
        // C# settings
        "dotnet.defaultSolution": "DotNetAtlas.slnx",
        "omnisharp.enableRoslynAnalyzers": true,
        "omnisharp.enableEditorConfigSupport": true,
        // Editor settings
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "ms-dotnettools.csharp",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        // Terminal settings
        "terminal.integrated.defaultProfile.linux": "pwsh"
        // Postgres connections are added interactively via the PostgreSQL extension
        // (ms-ossdata.vscode-pgsql): host 127.0.0.1, port 5433, user postgres, one
        // database per bounded context. The database list + credentials are printed
        // by .devcontainer/post-attach.sh on every attach.
      }
    }
  },
  // Explicit forwards + labels for the local `dotnet run` inner loop (BC APIs on
  // 5100-5106) and the infra service UIs. autoForwardPorts (above) additionally
  // surfaces container ports from compose output — e.g. the 8100-8107 BC APIs and
  // 8089-8096 outbox relays that only exist under `--profile full`.
  "forwardPorts": [
    5100, // Basket API (dotnet run)
    5101, // Catalog API (dotnet run)
    5102, // Inventory API (dotnet run)
    5103, // Invoicing API (dotnet run)
    5104, // Notifications API (dotnet run)
    5105, // Ordering API (dotnet run)
    5106, // Payments API (dotnet run)
    5433, // PostgreSQL
    6379, // Redis (basket — authoritative store)
    6380, // Redis (cache — volatile)
    5540, // Redis Insight
    8025, // Mailpit (email UI)
    5341, // Seq logging
    16686, // Jaeger UI
    9090, // Prometheus
    3000, // Grafana
    4317, // OTEL Collector gRPC
    4318, // OTEL Collector HTTP
    9094, // Kafka external
    8081, // Schema Registry
    9000, // AKHQ (Kafka UI)
    9011, // Keycloak
    10000 // Azurite (blob)
  ],
  // Port labels for better identification
  "portsAttributes": {
    "5100": {
      "label": "Basket API",
      "onAutoForward": "notify"
    },
    "5101": {
      "label": "Catalog API",
      "onAutoForward": "notify"
    },
    "5102": {
      "label": "Inventory API",
      "onAutoForward": "notify"
    },
    "5103": {
      "label": "Invoicing API",
      "onAutoForward": "notify"
    },
    "5104": {
      "label": "Notifications API",
      "onAutoForward": "notify"
    },
    "5105": {
      "label": "Ordering API",
      "onAutoForward": "notify"
    },
    "5106": {
      "label": "Payments API",
      "onAutoForward": "notify"
    },
    "5433": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis (basket)",
      "onAutoForward": "silent"
    },
    "6380": {
      "label": "Redis (cache)",
      "onAutoForward": "silent"
    },
    "5540": {
      "label": "Redis Insight",
      "onAutoForward": "notify"
    },
    "8025": {
      "label": "Mailpit (email)",
      "onAutoForward": "notify"
    },
    "5341": {
      "label": "Seq Logging",
      "onAutoForward": "notify"
    },
    "16686": {
      "label": "Jaeger UI",
      "onAutoForward": "notify"
    },
    "9090": {
      "label": "Prometheus",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Grafana",
      "onAutoForward": "notify"
    },
    "4317": {
      "label": "OTEL gRPC",
      "onAutoForward": "silent"
    },
    "4318": {
      "label": "OTEL HTTP",
      "onAutoForward": "silent"
    },
    "9094": {
      "label": "Kafka",
      "onAutoForward": "silent"
    },
    "8081": {
      "label": "Schema Registry",
      "onAutoForward": "silent"
    },
    "9000": {
      "label": "AKHQ (Kafka UI)",
      "onAutoForward": "notify"
    },
    "9011": {
      "label": "Keycloak",
      "onAutoForward": "notify"
    },
    "10000": {
      "label": "Azurite (blob)",
      "onAutoForward": "silent"
    }
  }
}

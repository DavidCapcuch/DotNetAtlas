{
  // Cross-Cutting Concerns
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft": "Warning"
      }
    }
  },
  "OTEL_SERVICE_NAME": "OutboxRelay",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  // Kestrel:Endpoints wins over HTTP_PORTS from the chiseled base image and silences
  // the "Overriding HTTP_PORTS '8080'" startup warning.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  },
  // Infrastructure layer
  // Data
  "ConnectionStrings": {
    "Outbox": "Host=127.0.0.1;Port=5433;Database=Catalog;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true"
  },
  "EfCore": {
    "DbContextPoolSize": 10,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  // Communication & Messaging
  // EnableIdempotence constrains two of the settings below rather than merely preferring them:
  // librdkafka refuses to build the producer with MaxInFlight above 5, or with
  // MessageSendMaxRetries at 0. Raising MaxInFlight for throughput fails startup, it does not
  // degrade quietly.
  "KafkaProducer": {
    "ClientId": "outbox-relay-worker",
    "BootstrapServers": "localhost:9094",
    "Acks": "All",
    "EnableIdempotence": true,
    "MaxInFlight": 5,
    "CompressionType": "None",
    "LingerMs": 5,
    "BatchSize": 16384,
    "MessageTimeoutMs": 300000,
    "RequestTimeoutMs": 30000,
    "MessageSendMaxRetries": 10,
    "RetryBackoffMs": 100
  },
  // Background Processing
  // SchemaName/TableName are intentionally NOT defaulted here: each relay deployment binds its own
  // schema via OutboxRelay__SchemaName (see the per-relay containers in docker-compose). Omitting a
  // default keeps the worker fail-closed - a container missing its schema env var refuses to start
  // rather than silently draining the wrong schema.
  "OutboxRelay": {
    "PollingIntervalMs": 1000,
    "BatchSize": 1000,
    "FlushTimeoutMs": 30000,
    "ShutdownTimeoutMs": 60000
  },
  // Health Monitoring
  "OutboxRelayHealthCheck": {
    "DegradedThreshold": "00:00:30",
    "UnhealthyThreshold": "00:01:00",
    "StartupGracePeriod": "00:02:00"
  },
  "HealthChecks": {
    "OutboxRelayExecutionTimeout": "00:00:05",
    "KafkaTimeout": "00:00:03"
  },
  "OutboxMetricsCollector": {
    "ReportIntervalSeconds": 5
  }
}

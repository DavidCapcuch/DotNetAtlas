{
    "type": "record",
    "name": "ExtendSubscriptionCommand",
    "namespace": "Weather.Alerts",
    "doc": "Command sent by Extension Saga to extend a subscription in the Weather Alerts service after payment is complete.",
    "fields": [
        {
            "name": "CorrelationId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Correlation ID for tracking the workflow."
        },
        {
            "name": "UserId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "User whose subscription to extend."
        },
        {
            "name": "PaymentTransactionId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Payment transaction ID for correlation. Used for refunds if extension fails."
        },
        {
            "name": "DurationDays",
            "type": "int",
            "doc": "Duration to extend the subscription in days."
        },
        {
            "name": "RequestedAtUtc",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            },
            "doc": "UTC timestamp when extension was requested."
        }
    ]
}


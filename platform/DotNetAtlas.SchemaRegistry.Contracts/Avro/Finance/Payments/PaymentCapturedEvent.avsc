{
    "type": "record",
    "name": "PaymentCapturedEvent",
    "namespace": "Finance.Payments",
    "doc": "Event emitted when a payment has been successfully captured. The funds have been transferred.",
    "fields": [
        {
            "name": "CorrelationId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Correlation ID for tracking the payment workflow."
        },
        {
            "name": "UserId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "User whose payment was captured."
        },
        {
            "name": "PaymentTransactionId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Payment transaction ID for the captured funds. Used for refunds if needed."
        },
        {
            "name": "AuthorizationId",
            "type": "string",
            "doc": "Authorization ID that was captured."
        },
        {
            "name": "Amount",
            "type": {
                "type": "bytes",
                "logicalType": "decimal",
                "precision": 10,
                "scale": 2
            },
            "doc": "Captured payment amount."
        },
        {
            "name": "Currency",
            "type": "string",
            "doc": "ISO 4217 currency code."
        },
        {
            "name": "CapturedAtUtc",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            },
            "doc": "UTC timestamp when capture was completed."
        }
    ]
}


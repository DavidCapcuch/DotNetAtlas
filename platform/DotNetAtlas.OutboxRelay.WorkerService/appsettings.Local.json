{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Information"
      }
    }
  },
  "Kafka": {
    "AvroSerializer": {
      "AutoRegisterSchemas": true
    }
  },
  "OutboxRelay": {
    "PollingIntervalMs": 500,
    "BatchSize": 1000,
    "SchemaName": "weather",
    "TableName": "OutboxMessages",
    "FlushTimeoutMs": 30000,
    "ShutdownTimeoutMs": 60000
  }
}

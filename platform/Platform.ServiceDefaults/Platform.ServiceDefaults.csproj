<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Suppress NU1902: KubernetesClient has a known security vulnerability (transitive dependency of HealthChecks.UI) -->
        <NoWarn>$(NoWarn);NU1902</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />

        <!-- Serilog -->
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.Seq" />
        <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
        <PackageReference Include="Serilog.Settings.Configuration" />
        <PackageReference Include="Serilog.Exceptions" />
        <PackageReference Include="Serilog.Exceptions.EntityFrameworkCore" />
        <PackageReference Include="SerilogTracing.Expressions" />
        <PackageReference Include="Elastic.Serilog.Enrichers.Web" />

        <!-- Health Checks -->
        <PackageReference Include="AspNetCore.HealthChecks.Prometheus.Metrics" />
        <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />

        <!-- HTTP resilience (ADR-0009) -->
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />

        <!-- Service-to-service auth inbound validation (ADR-0010) -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

        <!-- Idempotency-Key output cache (ADR-0013) — Redis-backed -->
        <PackageReference Include="Microsoft.AspNetCore.OutputCaching.StackExchangeRedis" />

        <!-- Feature flags (ADR-0014) — vendor-neutral SDK + DI hosting -->
        <PackageReference Include="OpenFeature" />
        <PackageReference Include="OpenFeature.Hosting" />

        <!-- OTel PII allowlist processor (ADR-0011) -->
        <PackageReference Include="OpenTelemetry" />

        <!-- EF Core — ApplySqlScriptsOnStartupIfLocalAsync<TContext> (#213 + #269).
             .Relational supplies the GetDbConnection extension on DatabaseFacade.
             Evolve runs the same idempotent V*.sql files Flyway runs in compose, so the
             Local-laptop startup path exercises identical SQL to production. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Evolve" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Platform.SharedKernel\Platform.SharedKernel.csproj" />
    </ItemGroup>
</Project>

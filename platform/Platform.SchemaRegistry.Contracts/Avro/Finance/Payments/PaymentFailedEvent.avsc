{
    "type": "record",
    "name": "PaymentFailedEvent",
    "namespace": "Finance.Payments",
    "doc": "Event emitted by Payment Saga when payment processing fails terminally (after retries exhausted or non-retryable error). Business sagas listen to this to handle failure.",
    "fields": [
        {
            "name": "CorrelationId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Correlation ID shared with the business saga that initiated the payment."
        },
        {
            "name": "UserId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "User whose payment failed."
        },
        {
            "name": "ErrorCode",
            "type": "string",
            "doc": "Error code from the payment provider (e.g., 'INSUFFICIENT_FUNDS', 'CARD_DECLINED', 'FRAUD_SUSPECTED')."
        },
        {
            "name": "ErrorMessage",
            "type": "string",
            "doc": "Human-readable error message."
        },
        {
            "name": "FailedAtUtc",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            },
            "doc": "UTC timestamp when payment failed."
        }
    ]
}


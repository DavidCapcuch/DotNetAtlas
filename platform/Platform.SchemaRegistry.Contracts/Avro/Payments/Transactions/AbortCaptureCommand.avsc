{
    "type": "record",
    "name": "AbortCaptureCommand",
    "namespace": "Payments.Transactions",
    "doc": "Imperative command from the Checkout saga to PaymentProcessingSaga (the sub-saga) aborting a previously-authorized payment because the Checkout saga's confirmation step (stock + order) failed (ADR-0026). On receipt the sub-saga leaves its AwaitingCaptureApproval wait-state and issues VoidPaymentCommand to the Payments service — a free pre-capture void, never a refund. Correlated by OrderId per ADR-0029.",
    "fields": [
        {
            "name": "OrderId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Order this payment is for; the PaymentProcessingSaga correlation key (ADR-0029)."
        },
        {
            "name": "UserId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "User whose payment authorization is being aborted. Carried for log/audit context (the sub-saga authoritatively holds it in state)."
        },
        {
            "name": "Reason",
            "type": "string",
            "doc": "Reason the Checkout saga aborted the capture (e.g. order-confirmation failure / timeout). Flows onto the sub-saga's VoidPaymentCommand.Reason for the gateway-void audit trail."
        },
        {
            "name": "RequestedAtUtc",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            },
            "doc": "UTC timestamp when the Checkout saga aborted the capture."
        }
    ]
}

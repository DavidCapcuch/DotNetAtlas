{
    "type": "record",
    "name": "VoidPaymentCommand",
    "namespace": "Payments.Transactions",
    "doc": "Command sent by Payment Saga to void (cancel) an authorized payment that has not yet been captured.",
    "fields": [
        {
            "name": "OrderId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Order this payment is attached to; the saga correlation key the handler resolves the aggregate by (ADR-0029)."
        },
        {
            "name": "UserId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "User whose payment authorization to void."
        },
        {
            "name": "AuthorizationId",
            "type": "string",
            "doc": "Authorization ID from the payment provider to void."
        },
        {
            "name": "Reason",
            "type": "string",
            "doc": "Reason for voiding the authorization."
        },
        {
            "name": "RequestedAtUtc",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            },
            "doc": "UTC timestamp when void was requested."
        }
    ]
}


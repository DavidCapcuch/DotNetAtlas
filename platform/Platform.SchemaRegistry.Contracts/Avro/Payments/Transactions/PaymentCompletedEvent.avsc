{
    "type": "record",
    "name": "PaymentCompletedEvent",
    "namespace": "Payments.Transactions",
    "doc": "Event emitted by Payment Saga when payment processing is complete (authorization + capture succeeded). Business sagas listen to this event to continue their workflow.",
    "fields": [
        {
            "name": "OrderId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Order this payment is for; the Checkout saga correlation key (ADR-0029)."
        },
        {
            "name": "UserId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "User whose payment was completed."
        },
        {
            "name": "PaymentTransactionId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Payment transaction ID. Used for refunds if business operation fails."
        },
        {
            "name": "Amount",
            "type": {
                "type": "bytes",
                "logicalType": "decimal",
                "precision": 19,
                "scale": 4
            },
            "doc": "Amount that was charged."
        },
        {
            "name": "Currency",
            "type": "string",
            "doc": "ISO 4217 currency code."
        },
        {
            "name": "CompletedAtUtc",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            },
            "doc": "UTC timestamp when payment was completed."
        }
    ]
}


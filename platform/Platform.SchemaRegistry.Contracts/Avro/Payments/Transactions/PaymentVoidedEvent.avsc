{
    "type": "record",
    "name": "PaymentVoidedEvent",
    "namespace": "Payments.Transactions",
    "doc": "Event emitted when an authorized payment has been voided (cancelled before capture). Used for compensation when business operation fails before capture.",
    "fields": [
        {
            "name": "CorrelationId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Correlation ID for tracking the payment workflow."
        },
        {
            "name": "OrderId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Order this payment is for; the PaymentProcessingSaga correlation key (ADR-0029)."
        },
        {
            "name": "UserId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "User whose payment was voided."
        },
        {
            "name": "AuthorizationId",
            "type": "string",
            "doc": "Authorization ID that was voided."
        },
        {
            "name": "VoidedAtUtc",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            },
            "doc": "UTC timestamp when the void was completed."
        },
        {
            "name": "Reason",
            "type": ["null", "string"],
            "default": null,
            "doc": "Optional saga-supplied reason for the void (audit trail; null for forward-compatibility with consumers reading older writes). H-5 closeout follow-up."
        }
    ]
}

{
    "type": "record",
    "name": "PaymentCaptureFailedEvent",
    "namespace": "Payments.Transactions",
    "doc": "Event emitted when payment capture fails. The authorization should be voided.",
    "fields": [
        {
            "name": "OrderId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Order this payment is for; the PaymentProcessingSaga correlation key (ADR-0029)."
        },
        {
            "name": "UserId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "User whose payment capture failed."
        },
        {
            "name": "AuthorizationId",
            "type": "string",
            "doc": "Authorization ID that failed to capture."
        },
        {
            "name": "ErrorCode",
            "type": "string",
            "doc": "Error code from the payment provider."
        },
        {
            "name": "ErrorMessage",
            "type": "string",
            "doc": "Human-readable error message."
        },
        {
            "name": "IsRetryable",
            "type": "boolean",
            "doc": "Indicates whether this failure is retryable."
        },
        {
            "name": "FailedAtUtc",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            },
            "doc": "UTC timestamp when capture failed."
        }
    ]
}


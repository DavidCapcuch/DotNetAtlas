{
    "type": "record",
    "name": "CapturePaymentCommand",
    "namespace": "Payments.Transactions",
    "doc": "Command sent by Payment Saga to capture an authorized payment.",
    "fields": [
        {
            "name": "OrderId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Order this payment is attached to; the saga correlation key the handler resolves the aggregate by (ADR-0029)."
        },
        {
            "name": "UserId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "User whose payment to capture."
        },
        {
            "name": "AuthorizationId",
            "type": "string",
            "doc": "Authorization ID from the payment provider to capture."
        },
        {
            "name": "Amount",
            "type": {
                "type": "bytes",
                "logicalType": "decimal",
                "precision": 19,
                "scale": 4
            },
            "doc": "Amount to capture (may be less than or equal to authorized amount)."
        },
        {
            "name": "RequestedAtUtc",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            },
            "doc": "UTC timestamp when capture was requested."
        }
    ]
}


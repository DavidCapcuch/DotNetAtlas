{
    "type": "record",
    "name": "RequestPaymentCommand",
    "namespace": "Payments.Transactions",
    "doc": "Imperative command from the Checkout saga to PaymentProcessingSaga (the sub-saga) asking it to drive a payment through authorize → capture for the supplied order. The Checkout saga's state machine awaits the matching PaymentCompletedEvent or PaymentFailedEvent (correlated by CorrelationId) to advance. Renamed from PaymentRequestedEvent and moved to payments.payment-commands per ADR-0023; the wire shape is identical.",
    "fields": [
        {
            "name": "CorrelationId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Correlation ID shared across the entire business flow (e.g., checkout → order → payment → invoice). Also the Kafka message key for payments.payment-commands partitioning."
        },
        {
            "name": "OrderId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "default": "00000000-0000-0000-0000-000000000000",
            "doc": "Ordering aggregate id this payment is attached to. Persisted on the Payments-side aggregate as a debugging/admin-lookup convenience; downstream Payments events drop it (cross-BC linkage stays CorrelationId)."
        },
        {
            "name": "UserId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "User initiating the payment."
        },
        {
            "name": "PaymentMethodId",
            "type": "string",
            "doc": "Gateway-issued opaque payment-method token (e.g. Stripe 'pm_*', Adyen alphanumeric); 1-64 chars. BREAKING change in the Wave-1 closeout C-2 fix: previously typed as logicalType:uuid which blocked any real-PSP adapter swap because no real gateway issues UUID-shaped payment-method ids."
        },
        {
            "name": "Amount",
            "type": {
                "type": "bytes",
                "logicalType": "decimal",
                "precision": 19,
                "scale": 4
            },
            "doc": "Payment amount."
        },
        {
            "name": "Currency",
            "type": "string",
            "doc": "ISO 4217 currency code (e.g., 'USD', 'EUR')."
        },
        {
            "name": "IdempotencyKey",
            "type": "string",
            "doc": "Idempotency key for preventing duplicate payment processing."
        },
        {
            "name": "RequestedAtUtc",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            },
            "doc": "UTC timestamp when payment was requested."
        }
    ]
}

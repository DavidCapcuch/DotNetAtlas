{
    "type": "record",
    "name": "RequestRefundCommand",
    "namespace": "Payments.Transactions",
    "doc": "Command sent by Payment Saga to request a refund for a captured payment.",
    "fields": [
        {
            "name": "UserId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "User to refund."
        },
        {
            "name": "PaymentTransactionId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Original payment transaction ID to refund."
        },
        {
            "name": "Reason",
            "type": "string",
            "doc": "Reason for the refund request."
        },
        {
            "name": "RequestedAtUtc",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            },
            "doc": "UTC timestamp when refund was requested."
        }
    ]
}


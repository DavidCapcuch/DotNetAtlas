{
    "type": "record",
    "name": "AlertSubscriptionPurchaseCompletedEvent",
    "namespace": "Order.AlertSubscriptions",
    "doc": "Event emitted by the Purchase Saga when the subscription purchase workflow completes successfully. Consumed by Order service to update order status.",
    "fields": [
        {
            "name": "CorrelationId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "Correlation ID matching the AlertSubscriptionOrderId."
        },
        {
            "name": "UserId",
            "type": {
                "type": "string",
                "logicalType": "uuid"
            },
            "doc": "User whose subscription purchase completed."
        },
        {
            "name": "CompletedAtUtc",
            "type": {
                "type": "long",
                "logicalType": "timestamp-millis"
            },
            "doc": "UTC timestamp when the purchase workflow completed."
        }
    ]
}

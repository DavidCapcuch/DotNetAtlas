<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FastEndpoints.Testing"/>

        <!-- Auth (JwtBearer test relaxation lives in Auth/) — JsonWebTokens namespace comes transitively. -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>

        <!-- Database -->
        <PackageReference Include="Testcontainers.PostgreSql"/>
        <PackageReference Include="Evolve"/>
        <PackageReference Include="Respawn"/>
        <PackageReference Include="Npgsql"/>

        <!-- Redis -->
        <PackageReference Include="Testcontainers.Redis"/>
        <PackageReference Include="StackExchange.Redis"/>

        <!-- Kafka -->
        <PackageReference Include="Testcontainers.Kafka"/>
        <PackageReference Include="Confluent.Kafka"/>
        <PackageReference Include="Confluent.SchemaRegistry.Serdes.Avro"/>
        <PackageReference Include="KafkaFlow"/>

        <!-- Stubbing for shared test helpers (FakeKafkaMessageContext). -->
        <PackageReference Include="NSubstitute"/>

        <!-- Assertions for shared FluentAssertions-style helpers (Assertions/OutboxMessageAssertions.cs). -->
        <PackageReference Include="AwesomeAssertions"/>

        <!-- OpenTelemetry -->
        <PackageReference Include="OpenTelemetry"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Platform projects used directly by shared test helpers (Avro serdes, messaging abstractions, outbox). -->
        <ProjectReference Include="..\Platform.Avro.UniversalSerDes\Platform.Avro.UniversalSerDes.csproj" />
        <ProjectReference Include="..\Platform.Messaging.Abstractions\Platform.Messaging.Abstractions.csproj" />
        <ProjectReference Include="..\Platform.ReliableMessaging.Outbox.Core\Platform.ReliableMessaging.Outbox.Core.csproj" />
        <ProjectReference Include="..\Platform.ReliableMessaging.Outbox.EFCore\Platform.ReliableMessaging.Outbox.EFCore.csproj" />
    </ItemGroup>

</Project>

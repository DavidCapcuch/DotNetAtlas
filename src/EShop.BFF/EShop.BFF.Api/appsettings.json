{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
      }
    }
  },
  "OTEL_SERVICE_NAME": "BFF",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",

  "Authentication": {
    "JwtBearer": {
      "Authority": "http://localhost:9011/realms/dotnetatlas"
    },
    "SwaggerClient": {
      "ClientId": "dotnetatlas-swagger"
    }
  },

  "ServiceAuth": {
    "_comment_secret": "Local-dev only. Production overrides via a secret store per ADR-0010.",
    "Authority": "http://localhost:9011/realms/dotnetatlas",
    "ClientId": "bff",
    "ClientSecret": "dev-bff-secret-rotate-in-prod",
    "ServiceName": "bff"
  },

  "Bff": {
    "Catalog": {
      "BaseUrl": "http://localhost:5101",
      "Scope": "catalog.read"
    },
    "Inventory": {
      "BaseUrl": "http://localhost:5102",
      "Scope": "inventory.read"
    }
  },

  "ConnectionStrings": {
    "Redis:Cache": "localhost:6380,defaultDatabase=0,allowAdmin=true,connectTimeout=2000,syncTimeout=2000,abortConnect=false"
  },

  "FeatureFlags": {
    "FilePath": "flags.json"
  },

  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    }
  },

  "Topics": {
    "CatalogProducts": "catalog.products",
    "CatalogCategories": "catalog.categories",
    "InventoryStockEvents": "inventory.stock-events"
  },

  "KafkaBffCacheInvalidationConsumer": {
    "GroupId": "bff-group",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Latest"
  }
}

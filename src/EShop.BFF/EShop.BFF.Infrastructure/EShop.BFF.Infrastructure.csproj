<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <!-- Result pattern -->
        <PackageReference Include="FluentResults"/>

        <!-- Options binding + validation -->
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations"/>

        <!-- Outbound HTTP resilience (BFF owns its typed clients — bff.md § 2.1) -->
        <PackageReference Include="Microsoft.Extensions.Http.Resilience"/>

        <!-- Kafka cache-invalidation consumer (group bff-group; consumer-only, no producer/inbox/DLT — bff.md § 2.2) -->
        <PackageReference Include="KafkaFlow.Microsoft.DependencyInjection"/>
        <PackageReference Include="KafkaFlow.LogHandler.Microsoft"/>
        <PackageReference Include="KafkaFlow.OpenTelemetry"/>
        <PackageReference Include="KafkaFlow.Serializer.SchemaRegistry.ConfluentAvro"/>

        <!-- Composed-response edge cache: FusionCache + Redis L2 + backplane on redis-cache -->
        <PackageReference Include="StackExchange.Redis"/>
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis"/>
        <PackageReference Include="ZiggyCreatures.FusionCache"/>
        <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis"/>
        <PackageReference Include="ZiggyCreatures.FusionCache.OpenTelemetry"/>
        <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson"/>

        <!-- Health checks: application-lifecycle + redis-cache probes -->
        <PackageReference Include="AspNetCore.HealthChecks.ApplicationStatus"/>
        <PackageReference Include="AspNetCore.HealthChecks.Redis"/>

        <!-- OpenTelemetry -->
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol"/>
        <PackageReference Include="OpenTelemetry.Extensions.Hosting"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.Http"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.Process"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis"/>
        <PackageReference Include="OpenTelemetry.Resources.Container"/>
        <PackageReference Include="OpenTelemetry.Resources.Host"/>

        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\platform\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
        <ProjectReference Include="..\..\..\platform\Platform.SharedKernel\Platform.SharedKernel.csproj" />
        <!-- Avro contracts consumed (never produced) by the bff-group cache invalidator (bff.md § 1 + § 2.2). -->
        <ProjectReference Include="..\..\..\platform\Platform.SchemaRegistry.Contracts\Platform.SchemaRegistry.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="EShop.BFF.Api"/>
        <InternalsVisibleTo Include="EShop.BFF.ArchitectureTests"/>
        <InternalsVisibleTo Include="EShop.BFF.IntegrationTests"/>
        <InternalsVisibleTo Include="EShop.BFF.UnitTests"/>
    </ItemGroup>

</Project>

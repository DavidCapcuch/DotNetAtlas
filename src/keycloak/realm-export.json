      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "851240598849-tji85r9f4mpjne714rm7m5ttsruhs54d.apps.googleusercontent.com",
        "clientSecret": "GoogleClientSecretThatShouldBeInVaultAndNotExposed",
        "defaultScope": "openid profile email",

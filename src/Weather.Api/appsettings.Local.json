{
  // Cross-Cutting Concerns
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Polly": "Warning",
        "Microsoft.AspNetCore.Diagnostics": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.SignalR": "Debug",
        "Microsoft.AspNetCore.Http.Connections": "Debug",
        "ZiggyCreatures.Caching.Fusion": "Debug"
      }
    }
  },
  // Infrastructure layer
  // Communication & Messaging
  "Kafka": {
    "AvroSerializer": {
      "AutoRegisterSchemas": true
    }
  },
  // Authentication & Authorization
  // Dev-only overrides: the committed appsettings.json reads as production-intent
  // (placeholder secrets, RequireHttpsMetadata=true). Values below let the reference
  // app run against the local Keycloak container without any secret store setup.
  "Authentication": {
    "JwtBearer": {
      "RequireHttpsMetadata": false
    },
    "OAuth": {
      "RequireHttpsMetadata": false,
      "ClientSecret": "super-secret-secret-that-should-be-regenerated-for-production"
    },
    "Oidc": {
      "RequireHttpsMetadata": false,
      "ClientSecret": "super-secret-secret-that-should-be-regenerated-for-production"
    }
  },
  // Local Docker Postgres password matches the one in .env / docker-compose.yaml.
  "ConnectionStrings": {
    "Weather": "Host=127.0.0.1;Port=5433;Database=Weather;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true"
  },
  // Throwaway dev key for api.weatherapi.com; rate-limited free tier.
  "WeatherProviders": {
    "WeatherApiCom": {
      "ApiKey": "1751c23e0f8c4157b3383940251509"
    }
  },
  "SignalR": {
    "EnableDetailedErrors": true,
    "ClientTimeoutSeconds": 90,
    "KeepAliveSeconds": 20
  }
}

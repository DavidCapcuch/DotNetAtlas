    {
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "Fires when no healthcheck series exist for job bc-healthchecks at all. The severity tiles beside it fall back to or on() vector(0), so a job or metric rename makes them read 0 and render green - an all-clear for a board measuring nothing; Targets Down cannot catch a metric rename because the targets are still scraped. Keep sum(): without it the two or-branches carry different label sets, and a range spanning the metric arriving renders two series. Job-wide and all-or-nothing within one job - the outbox-relay-healthchecks targets are outside both guards.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "OK"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "MISSING"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent"
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 1

    {
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "Scrape targets that are down. A crash-looping container stops being scraped, so its healthcheck series disappear rather than going to zero - the Unhealthy panel then reads 0 for a service that is dead. This is the dead man's switch for that: a container that fails to boot at all, or one killed mid-restart, shows up here and nowhere else - which is why it sits beside Unhealthy in the Overall band rather than under a row of its own.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent"
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"

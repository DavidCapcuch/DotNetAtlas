{
  "servers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@2.1.8"
      ],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": "5000"
      },
      "alwaysAllow": [
        "resolve-library-id",
        "get-library-docs"
      ]
    },
    "Microsoft Docs": {
      "type": "sse",
      "url": "https://learn.microsoft.com/api/mcp",
      "alwaysAllow": [
        "microsoft_docs_search",
        "microsoft_docs_fetch"
      ]
    },
    "NuGet Server": {
      "type": "stdio",
      "command": "dnx",
      "args": [
        "NuGet.Mcp.Server",
        "--prerelease",
        "--yes"
      ],
      "alwaysAllow": [
        "search_packages",
        "get_package_details"
      ]
    }
  }
}

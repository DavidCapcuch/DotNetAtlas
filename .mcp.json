{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@2.1.8"
      ],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": "5000"
      }
    },
    "DeepWiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "Microsoft Docs": {
      "type": "sse",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "NuGet Server": {
      "type": "stdio",
      "command": "dnx",
      "args": [
        "NuGet.Mcp.Server",
        "--prerelease",
        "--yes"
      ]
    }
  }
}

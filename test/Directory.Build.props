<Project>
    <PropertyGroup>
        <RootBuildPropsPath>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</RootBuildPropsPath>
    </PropertyGroup>
    <Import Project="$(RootBuildPropsPath)" Condition="Exists('$(RootBuildPropsPath)')"/>

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <SonarQubeTestProject>true</SonarQubeTestProject>
        <CoverletOutput>$(MSBuildProjectDirectory)/TestResults/</CoverletOutput>
    </PropertyGroup>

    <!--
      Disable CentralPackageTransitivePinningEnabled (root #139) for test/ projects.
      Test code doesn't ship to production so NU1903 transitive-vuln pinning is not
      load-bearing. Disabling lets BC project references' unversioned PackageReferences
      resolve from their own (root) CPM tier — without this, the test tier needs to
      mirror every transitive in the BC chain (~50+ pins), which is undue maintenance
      burden for non-shipping code.
    -->
    <PropertyGroup>
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- Shared test configuration files -->
    <ItemGroup>
        <Content Include="$(MSBuildThisFileDirectory)xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="$(MSBuildThisFileDirectory)coverlet.runsettings" Link="coverlet.runsettings" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!-- Common usings -->
    <ItemGroup>
        <Using Include="Xunit"/>
        <Using Include="AwesomeAssertions"/>
        <Using Include="AwesomeAssertions.Execution"/>
    </ItemGroup>

    <!-- Common test packages for all test projects -->
    <ItemGroup>
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="AwesomeAssertions"/>
        <PackageReference Include="AwesomeAssertions.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Suppress VSTHRD200 (Async suffix) for test projects only.
         NU1903: transitive-vuln audit. Production tiers (services/, platform/) keep NU1903 as a
         build-blocking error; test projects don't ship, and this tier already disables transitive-vuln
         PINNING (CentralPackageTransitivePinningEnabled=false above) on the stated grounds that it is
         "not load-bearing" for test code. So a transitive advisory a test pulls (e.g. MessagePack via
         SignalR.Protocols.MessagePack — patched at the services tier) must not fail the test build via
         TreatWarningsAsErrors. -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);VSTHRD200;NU1903</NoWarn>
    </PropertyGroup>
</Project>

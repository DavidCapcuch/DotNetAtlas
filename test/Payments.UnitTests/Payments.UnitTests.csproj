<Project Sdk="Microsoft.NET.Sdk">
    <!-- Project-specific packages only (common packages in test/Directory.Build.props) -->
    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="NSubstitute.Analyzers.CSharp">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentResults.Extensions.FluentAssertions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\services\Payments\Payments.Domain\Payments.Domain.csproj" />
        <ProjectReference Include="..\..\services\Payments\Payments.Application\Payments.Application.csproj" />
        <ProjectReference Include="..\..\services\Payments\Payments.Infrastructure\Payments.Infrastructure.csproj" />
    </ItemGroup>

    <!-- The deployed configuration itself, so KafkaOptionsTests binds what ships rather than a
         hand-written copy that can drift from it. Linked rather than reached through a reference
         to Payments.Api: only the file is needed, not the host assembly. -->
    <ItemGroup>
        <Content Include="..\..\services\Payments\Payments.Api\appsettings.json" Link="appsettings.json"
                 CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>

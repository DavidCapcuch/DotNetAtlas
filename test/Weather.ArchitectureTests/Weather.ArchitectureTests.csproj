<Project Sdk="Microsoft.NET.Sdk">
    <!-- Project-specific packages only (common packages in Directory.Build.props) -->
    <ItemGroup>
        <PackageReference Include="NetArchTest.eNhancedEdition"/>

        <!-- CVE-bumped transitives promoted to direct refs (test/ tier disables
             transitive pinning, so pins in test/Directory.Packages.props only
             bind when referenced directly). PrivateAssets=all prevents leak. -->
        <PackageReference Include="Microsoft.Kiota.Abstractions">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="System.Security.Cryptography.Xml">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Weather.Api\Weather.Api.csproj" />
        <ProjectReference Include="..\..\platform\Platform.Test.Framework\Platform.Test.Framework.csproj" />
    </ItemGroup>

</Project>

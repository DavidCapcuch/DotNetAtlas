<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="FluentResults.Extensions.FluentAssertions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\services\Ordering\Ordering.Domain\Ordering.Domain.csproj" />
        <ProjectReference Include="..\..\services\Ordering\Ordering.Application\Ordering.Application.csproj" />
        <ProjectReference Include="..\..\services\Ordering\Ordering.Infrastructure\Ordering.Infrastructure.csproj" />
    </ItemGroup>

    <!-- The deployed configuration itself, so KafkaOptionsTests binds what ships rather than a
         hand-written copy that can drift from it. Linked rather than reached through a reference
         to Ordering.Api: only the file is needed, not the host assembly. -->
    <ItemGroup>
        <Content Include="..\..\services\Ordering\Ordering.Api\appsettings.json" Link="appsettings.json"
                 CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>

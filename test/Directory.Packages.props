        <PackageVersion Include="Respawn" Version="7.0.0"/>
        <PackageVersion Include="WireMock.Net" Version="2.14.0"/>
        <!-- NU1902 remediation: WireMock.Net 2.6.0 pulls transitive Scriban.Signed 7.0.6, flagged
             by two moderate advisories (GHSA-6q7j-xr26-3h2c, GHSA-q6rr-fm2g-g5x8). The test tier
             disables CentralPackageTransitivePinningEnabled (test/Directory.Build.props), so each
             WireMock.Net consumer promotes Scriban.Signed to a direct PackageReference to override
             the vulnerable transitive. A WireMock bump does NOT remove this pin: latest 2.11.0 still
             pulls Scriban.Signed 7.2.0, also flagged — only 7.2.1 clears both (verified 2026-07).
             Remove this pin + the references once a WireMock.Net release ships Scriban.Signed >= 7.2.1. -->
        <PackageVersion Include="Scriban.Signed" Version="7.2.6"/>
        <!-- Assertion libraries -->
        <PackageVersion Include="AwesomeAssertions" Version="9.5.0"/>
        <PackageVersion Include="FluentResults.Extensions.FluentAssertions" Version="2.2.1"/>
        <!-- Mocking -->
        <PackageVersion Include="NSubstitute" Version="5.3.0"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0"/>
        <!-- SignalR testing -->
        <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10"/>
        <PackageVersion Include="TypedSignalR.Client" Version="3.6.0"/>
        <!-- Architecture testing -->
        <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5"/>
        <!-- Analyzers -->
        <PackageVersion Include="AwesomeAssertions.Analyzers" Version="9.0.8"/>
        <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17"/>
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556"/>

        <!-- Transitive pins for NU1903 vulnerabilities (closes #139). -->
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10"/>
    </ItemGroup>
</Project>

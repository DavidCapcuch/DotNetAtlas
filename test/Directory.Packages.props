<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- Test framework packages -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8"/>
        <PackageVersion Include="Ardalis.SmartEnum.EFCore" Version="8.2.0"/>
        <PackageVersion Include="FluentValidation" Version="12.1.1"/>
        <PackageVersion Include="xunit.v3" Version="3.2.2"/>
        <PackageVersion Include="xunit.analyzers" Version="1.27.0"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1"/>
        <!-- Test infrastructure -->
        <PackageVersion Include="coverlet.collector" Version="10.0.1"/>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8"/>
        <PackageVersion Include="FastEndpoints.Testing" Version="8.1.0"/>
        <PackageVersion Include="Confluent.Kafka" Version="2.14.0"/>
        <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Avro" Version="2.14.0"/>
        <PackageVersion Include="Serilog.Sinks.XUnit.Injectable" Version="4.0.222"/>
        <PackageVersion Include="Npgsql" Version="10.0.2"/>
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.11.0"/>
        <PackageVersion Include="Testcontainers.Redis" Version="4.11.0"/>
        <PackageVersion Include="Testcontainers.Kafka" Version="4.11.0"/>
        <PackageVersion Include="Testcontainers.Azurite" Version="4.11.0"/>
        <PackageVersion Include="Azure.Storage.Blobs" Version="12.28.0"/>
        <PackageVersion Include="StackExchange.Redis" Version="2.13.1"/>
        <PackageVersion Include="Respawn" Version="7.0.0"/>
        <PackageVersion Include="WireMock.Net" Version="1.8.0"/>
        <!-- Assertion libraries -->
        <PackageVersion Include="AwesomeAssertions" Version="9.4.0"/>
        <PackageVersion Include="FluentResults.Extensions.FluentAssertions" Version="2.2.1"/>
        <!-- Mocking -->
        <PackageVersion Include="NSubstitute" Version="5.3.0"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.6.0"/>
        <!-- SignalR testing -->
        <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8"/>
        <PackageVersion Include="TypedSignalR.Client" Version="3.6.0"/>
        <!-- Architecture testing -->
        <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5"/>
        <!-- Analyzers -->
        <PackageVersion Include="AwesomeAssertions.Analyzers" Version="9.0.8"/>
        <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17"/>
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556"/>
    </ItemGroup>
</Project>

{
  "permissions": {
    "deny": [
      "Edit(**/Persistence/Database/Migrations/*.cs)",
      "Write(**/Persistence/Database/Migrations/*.cs)",
      "Edit(**/Persistence/Database/Migrations/*ModelSnapshot.cs)",
      "Write(**/Persistence/Database/Migrations/*ModelSnapshot.cs)",
      "Edit(**/Persistence/Database/Migrations/SqlScripts/V*.sql)",
      "Write(**/Persistence/Database/Migrations/SqlScripts/V*.sql)",
      "Edit(**/packages.lock.json)",
      "Write(**/packages.lock.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/check-commit-msg.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/format-changed.ps1"
          }
        ]
      }
    ]
  }
}

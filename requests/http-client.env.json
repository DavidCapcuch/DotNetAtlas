    "Auth_ClientId": "e9fdb985-9173-4e01-9d73-ac2d60d1dc8e",
    "Auth_Scopes": "openid profile email",
    // JetBrains HTTP Client OAuth2 helper. First call against a request that uses
    // {{$auth.token("keycloak-local")}} opens Keycloak in the browser; log in as
    // dev@dotnetatlas.com / 123456789. The IDE caches the token per user (outside
    // this file) and refreshes silently. Uses the dedicated public Swagger client
    // with PKCE - no client secret involved.
    "Security": {
      "Auth": {
        "keycloak-local": {
          "Type": "OAuth2",
          "Grant Type": "Authorization Code",
          "Auth URL": "http://localhost:9011/realms/dotnetatlas/protocol/openid-connect/auth",
          "Token URL": "http://localhost:9011/realms/dotnetatlas/protocol/openid-connect/token",
          "Client ID": "dotnetatlas-swagger",
          "Redirect URL": "http://localhost:63342/rest/oauth2/callback",
          "Acquire Automatically": true,
          "PKCE": true,
          "Scope": "openid profile email"
        }
      }
    }
  },

### Publish Subscription Extended Event
# Publishes a SubscriptionExtendedEvent to Kafka for dev testing.
# Simulates what the Billing Service would emit when a subscription extension is purchased.
# @name PublishSubscriptionExtended_30Days
POST {{AppHostAddress}}/api/v1/dev/publish-subscription-extended
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "userId": "00000000-0000-0000-0000-111111111111",
  "paymentTransactionId": "{{$guid}}",
  "durationExtendedDays": 30
}


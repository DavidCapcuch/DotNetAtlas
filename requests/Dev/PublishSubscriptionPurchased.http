### Publish Subscription Purchased Event
# Publishes a SubscriptionPurchasedEvent to Kafka for dev testing.
# Simulates what the Billing Service would emit when a purchase is completed.
# @name PublishSubscriptionPurchased_Pro
POST {{AppHostAddress}}/api/v1/dev/publish-subscription-purchased
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "userId": "00000000-0000-0000-0000-111111111111",
  "paymentTransactionId": "{{$guid}}",
  "subscriptionTier": "Pro",
  "durationDays": 30
}


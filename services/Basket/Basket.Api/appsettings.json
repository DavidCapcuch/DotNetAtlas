{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
        "ZiggyCreatures.Caching.Fusion": "Information"
      }
    }
  },
  "OTEL_SERVICE_NAME": "Basket",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",

  "Cors": {
    "AllowedOrigins": [
      "https://app.example.com"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "Idempotency-Key"
    ],
    "ExposedHeaders": [],
    "AllowCredentials": true
  },

  "Authentication": {
    "JwtBearer": {
      "_comment_deployed": "Base ships no JWT Authority so this edge is deployment-shaped: the dev-only http://localhost Keycloak Authority lives in appsettings.Development.json and appsettings.Testing.json, and a deployed host that sets no Authority fails closed at boot via the platform AssertDeployedAuthorityConfigured guard. RequireHttpsMetadata stays true so deployed environments trust only https:// OIDC metadata; see ADR-0009 item 10.",
      "TokenValidationParameters": {
        "ValidAudience": "basket-service"
      },
      "RequireHttpsMetadata": true
    },
    "SwaggerClient": {
      "ClientId": "dotnetatlas-swagger"
    }
  },

  "ServiceAuth": {
    "_comment_secret": "Local-dev only. Deployed environments override ServiceAuth__ClientSecret from a secret store per ADR-0010.",
    "_comment_deployed": "Base ships no ServiceAuth Authority so this outbound edge is deployment-shaped: the dev-only http://localhost Keycloak Authority lives in appsettings.Development.json and appsettings.Testing.json, and a deployed host that sets no ServiceAuth Authority fails boot via the AddServiceAuth guard ([Required] + https), because the client_secret POSTs to the token endpoint derived from it. See ADR-0009 item 10.",
    "ClientId": "basket-service",
    "ClientSecret": "dev-basket-service-secret-rotate-in-prod",
    "ServiceName": "basket-service"
  },

  "ConnectionStrings": {
    "Basket": "Host=127.0.0.1;Port=5433;Database=Basket;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true",
    "Redis:Basket": "localhost:6379,defaultDatabase=0,allowAdmin=true,connectTimeout=2000,syncTimeout=2000,abortConnect=false",
    "Redis:Cache": "localhost:6380,defaultDatabase=0,allowAdmin=true,connectTimeout=2000,syncTimeout=2000,abortConnect=false"
  },

  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },

  "Basket": {
    "Redis": {
      "TtlDays": 30,
      "LockTimeoutSeconds": 5,
      "LockRetryDelayMs": 250,
      "LockMaxRetries": 20
    },
    "Catalog": {
      "BaseUrl": "http://localhost:5161",
      "TimeoutSeconds": 2,
      "Scope": "catalog.read"
    }
  },

  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    }
  },

  "Topics": {
    "BasketSessions": "basket.sessions",
    "DltTopicSuffix": ".Basket.DLT"
  },

  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "RedisTimeout": "00:00:04"
  }
}

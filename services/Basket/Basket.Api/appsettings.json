{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
        "ZiggyCreatures.Caching.Fusion": "Information"
      }
    }
  },
  "OTEL_SERVICE_NAME": "Basket",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",

  "Cors": {
    "AllowedOrigins": [
      "https://app.example.com"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "Idempotency-Key"
    ],
    "ExposedHeaders": [],
    "AllowCredentials": true
  },

  "Authentication": {
    "JwtBearer": {
      "_comment_deployed": "RequireHttpsMetadata ships true so deployed environments are HTTPS-only by default; appsettings.Development.json and appsettings.Testing.json relax it for the local http Keycloak. Deployed environments must still point Authentication__JwtBearer__Authority at an https:// OIDC endpoint — the host refuses to start otherwise. Internal-plaintext-metadata topologies are unsupported by design; see ADR-0009 'Taking this to production'.",
      "Authority": "http://localhost:9011/realms/dotnetatlas",
      "TokenValidationParameters": {
        "ValidAudience": "basket-service"
      },
      "RequireHttpsMetadata": true
    },
    "SwaggerClient": {
      "ClientId": "dotnetatlas-swagger"
    }
  },

  "ServiceAuth": {
    "_comment_secret": "Local-dev only. Production overrides via env var KEYCLOAK__SERVICE_CLIENT_SECRET__basket per ADR-0010.",
    "_comment_deployed": "The http:// Authority is local-dev only. Deployed environments MUST set ServiceAuth__Authority to an https:// OIDC realm URL — the outbound AddServiceAuth guard fails the host boot otherwise, because the client_secret POSTs to the token endpoint derived from it. Internal-plaintext-metadata topologies are unsupported by design; see ADR-0009 item 10.",
    "Authority": "http://localhost:9011/realms/dotnetatlas",
    "ClientId": "basket-service",
    "ClientSecret": "ClientSecretThatShouldBeInVaultAndNotExposed",
    "ServiceName": "basket-service"
  },

  "ConnectionStrings": {
    "Basket": "Host=127.0.0.1;Port=5433;Database=Basket;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true",
    "Redis:Basket": "localhost:6379,defaultDatabase=0,allowAdmin=true,connectTimeout=2000,syncTimeout=2000,abortConnect=false",
    "Redis:Cache": "localhost:6380,defaultDatabase=0,allowAdmin=true,connectTimeout=2000,syncTimeout=2000,abortConnect=false"
  },

  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },

  "Basket": {
    "Redis": {
      "TtlDays": 30,
      "LockTimeoutSeconds": 5,
      "LockRetryDelayMs": 250,
      "LockMaxRetries": 20
    },
    "Catalog": {
      "BaseUrl": "http://localhost:5161",
      "TimeoutSeconds": 2,
      "Scope": "catalog.read"
    }
  },

  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    }
  },

  "Topics": {
    "BasketSessions": "basket.sessions",
    "DltTopicSuffix": ".Basket.DLT"
  },

  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "RedisTimeout": "00:00:04"
  }
}

{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
      }
    }
  },
  "OTEL_SERVICE_NAME": "Inventory",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",

  "Cors": {
    "AllowedOrigins": [
      "https://app.example.com"
    ],
    "AllowedMethods": [
      "GET",
      "POST"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "Idempotency-Key"
    ],
    "ExposedHeaders": [],
    "AllowCredentials": true
  },

  "Authentication": {
    "JwtBearer": {
      "_comment_deployed": "Base ships no JWT Authority so this edge is deployment-shaped: the dev-only http://localhost Keycloak Authority lives in appsettings.Development.json and appsettings.Testing.json, and a deployed host that sets no Authority fails closed at boot via the platform AssertDeployedAuthorityConfigured guard. RequireHttpsMetadata stays true so deployed environments trust only https:// OIDC metadata; see ADR-0009 item 10.",
      "TokenValidationParameters": {
        "ValidAudience": "inventory-service"
      },
      "RequireHttpsMetadata": true
    },
    "SwaggerClient": {
      "ClientId": "dotnetatlas-swagger"
    }
  },

  "ConnectionStrings": {
    "Inventory": "Host=127.0.0.1;Port=5433;Database=Inventory;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true",
    "Redis:Cache": "localhost:6380,defaultDatabase=0,allowAdmin=true,connectTimeout=2000,syncTimeout=2000,abortConnect=false"
  },
  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  "StockLevelCache": {
    "Ttl": "00:00:30",
    "FailSafeEnabled": true,
    "FailSafeMaxDuration": "00:05:00"
  },
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    }
  },
  "Topics": {
    "InventoryStockEvents": "inventory.stock-events",
    "InventoryReservations": "inventory.reservations",
    "InventoryReservationCommands": "inventory.reservation-commands",
    "CatalogProducts": "catalog.products",
    "OrderingOrders": "ordering.orders",
    "DltTopicSuffix": ".Inventory.DLT"
  },
  "KafkaReservationCommandsConsumer": {
    "GroupId": "inventory-group",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest"
  },
  "KafkaCatalogProductsConsumer": {
    "GroupId": "inventory-group",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest"
  },
  "KafkaOrderingOrdersConsumer": {
    "GroupId": "inventory-group",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest"
  },
  "HealthChecks": {
    "KafkaTimeout": "00:00:04",
    "RedisTimeout": "00:00:04"
  }
}

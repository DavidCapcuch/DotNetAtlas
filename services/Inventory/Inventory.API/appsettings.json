{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OTEL_SERVICE_NAME": "Inventory",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Inventory": "Host=127.0.0.1;Port=5433;Database=Inventory;Username=postgres;Password=PasswordThatShouldBeInVaultAndNotExposed;Include Error Detail=true"
  },
  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    }
  },
  "Topics": {
    "InventoryStockEvents": "inventory.stock-events",
    "InventoryReservations": "inventory.reservations",
    "DltTopicSuffix": ".Inventory.DLT"
  },
  "KafkaReservationCommandsConsumer": {
    "Topic": "inventory.reservation-commands",
    "GroupId": "inventory-reservation-commands",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false
  },
  "KafkaCatalogProductsConsumer": {
    "Topic": "catalog.products",
    "GroupId": "inventory-stock-init",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false
  },
  "KafkaOrderingOrdersConsumer": {
    "Topic": "ordering.orders",
    "GroupId": "inventory-stock-init",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false
  }
}

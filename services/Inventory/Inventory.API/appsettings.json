{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OTEL_SERVICE_NAME": "Inventory",
  "AllowedHosts": "*",
  // Kestrel endpoint binding — canonical config so HTTP_PORTS (set by the chiseled
  // base image) and ASPNETCORE_URLS (removed from Dockerfile/compose) no longer
  // race. Kestrel:Endpoints takes precedence and silences the
  // "Overriding HTTP_PORTS '8080'" startup warning.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5160",
      "https://localhost:7096"
    ],
    "AllowedMethods": [
      "GET",
      "POST"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "Idempotency-Key",
      "X-Correlation-Id"
    ],
    "ExposedHeaders": [],
    "AllowCredentials": true
  },

  "Authentication": {
    "JwtBearer": {
      "Authority": "http://localhost:9011/realms/dotnetatlas",
      "RequireHttpsMetadata": false
    }
  },

  "ServiceAuth": {
    "Authority": "http://localhost:9011/realms/dotnetatlas",
    "ClientId": "inventory-service",
    "ClientSecret": "ClientSecretThatShouldBeInVaultAndNotExposed",
    "ServiceName": "inventory-service"
  },

  "ConnectionStrings": {
    "Inventory": "Host=127.0.0.1;Port=5433;Database=Inventory;Username=postgres;Password=PasswordThatShouldBeInVaultAndNotExposed;Include Error Detail=true",
    "Redis:Cache": "localhost:6380,defaultDatabase=0,allowAdmin=true,connectTimeout=2000,syncTimeout=2000,abortConnect=false"
  },
  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    }
  },
  "Topics": {
    "InventoryStockEvents": "inventory.stock-events",
    "InventoryReservations": "inventory.reservations",
    "DltTopicSuffix": ".Inventory.DLT"
  },
  "KafkaReservationCommandsConsumer": {
    "Topic": "inventory.reservation-commands",
    "GroupId": "inventory-reservation-commands",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false
  },
  "KafkaCatalogProductsConsumer": {
    "Topic": "catalog.products",
    "GroupId": "inventory-stock-init",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false
  },
  "KafkaOrderingOrdersConsumer": {
    "Topic": "ordering.orders",
    "GroupId": "inventory-stock-init",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false
  }
}

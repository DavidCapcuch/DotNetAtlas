{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "KafkaFlow": "Information"
      }
    }
  },
  "OTEL_SERVICE_NAME": "Payments",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  // Kestrel:Endpoints wins over HTTP_PORTS from the chiseled base image and silences
  // the "Overriding HTTP_PORTS '8080'" startup warning.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  },
  "ConnectionStrings": {
    "Payments": "Host=127.0.0.1;Port=5433;Database=Payments;Username=postgres;Password=PasswordThatShouldBeInVaultAndNotExposed;Include Error Detail=true"
  },
  "Authentication": {
    "JwtBearer": {
      "Authority": "http://localhost:9011/realms/dotnetatlas",
      "TokenValidationParameters": {
        "ValidAudience": "payments-service"
      },
      "RequireHttpsMetadata": false
    }
  },
  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    }
  },
  "Topics": {
    "Transactions": "payments.transactions",
    "DltTopicSuffix": ".Payments.DLT"
  },
  "KafkaPaymentCommandsConsumer": {
    "Topic": "payments.payment-commands",
    "GroupId": "payments-group",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false
  },
  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "KafkaTimeout": "00:00:05"
  }
}

<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Ardalis.SmartEnum" Version="8.2.0"/>
        <PackageVersion Include="Ardalis.SmartEnum.EFCore" Version="8.2.0"/>
        <PackageVersion Include="Ardalis.Specification.EntityFrameworkCore" Version="9.3.1"/>
        <PackageVersion Include="Riok.Mapperly" Version="4.3.1"/>

        <!-- API-->
        <PackageVersion Include="FastEndpoints.Attributes" Version="8.1.0"/>
        <PackageVersion Include="FastEndpoints.Generator" Version="8.1.0"/>
        <PackageVersion Include="FastEndpoints.Security" Version="8.1.0"/>
        <PackageVersion Include="FastEndpoints.Swagger" Version="8.1.0"/>
        <PackageVersion Include="NetEscapades.AspNetCore.SecurityHeaders" Version="1.3.1"/>

        <!-- Validation-->
        <PackageVersion Include="FluentValidation" Version="12.1.1"/>
        <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1"/>
        <PackageVersion Include="FluentResults" Version="4.0.0"/>

        <!-- Options -->
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8"/>
        <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.8"/>

        <!-- Kafka -->
        <PackageVersion Include="Confluent.SchemaRegistry" Version="2.14.0"/>
        <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Avro" Version="2.14.0"/>
        <PackageVersion Include="KafkaFlow.LogHandler.Microsoft" Version="4.2.0"/>
        <PackageVersion Include="KafkaFlow.OpenTelemetry" Version="4.2.0"/>
        <PackageVersion Include="KafkaFlow.Retry" Version="3.1.0"/>
        <PackageVersion Include="KafkaFlow.Serializer.ApacheAvro" Version="1.5.8"/>
        <PackageVersion Include="KafkaFlow.Serializer.SchemaRegistry.ConfluentAvro" Version="4.2.0"/>
        <PackageVersion Include="KafkaFlow.Microsoft.DependencyInjection" Version="4.2.0"/>

        <!-- EF Core-->
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1"/>
        <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8"/>
        <PackageVersion Include="EntityFrameworkCore.Exceptions.Common" Version="10.0.0"/>
        <PackageVersion Include="EntityFrameworkCore.Exceptions.PostgreSQL" Version="10.0.0"/>

        <!-- Background jobs — Notifications per-channel dispatch (ADR-0032) -->
        <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.23"/>
        <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.Hangfire" Version="1.15.1-beta.1"/>

        <!-- Email — Notifications email channel → SMTP/Mailpit (ADR-0032) -->
        <PackageVersion Include="MailKit" Version="4.17.0"/>

        <PackageVersion Include="Bogus" Version="35.6.5"/>

        <!-- Redis + FusionCache (Basket primary store) -->
        <PackageVersion Include="MemoryPack.Core" Version="1.21.4"/>
        <PackageVersion Include="StackExchange.Redis" Version="2.13.1"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.8"/>
        <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.6.0"/>
        <PackageVersion Include="ZiggyCreatures.FusionCache.AspNetCore.OutputCaching" Version="2.6.0"/>
        <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.6.0"/>
        <PackageVersion Include="ZiggyCreatures.FusionCache.OpenTelemetry" Version="2.6.0"/>
        <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.CysharpMemoryPack" Version="2.6.0"/>

        <!-- Auth -->
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8"/>

        <!-- SignalR — Notifications in-app bell transport (ADR-0032). In-memory backplane only
             (no AddStackExchangeRedis — the multi-instance seam is ADR-0016). -->
        <PackageVersion Include="MessagePack.Annotations" Version="3.1.4"/>
        <!-- 10.0.9 closes CVE-2026-45591 / GHSA-f8h2-vmm9-qhj6 (NU1903, high): a deeply-nested
             MessagePack array in the SignalR hub protocol stack-overflows → unauthenticated remote
             DoS (affected 10.0.0-10.0.8; patched 10.0.9). -->
        <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.9"/>
        <!-- Transitive pin: SignalR.Protocols.MessagePack pulls a MessagePack 2.5.x that earlier
             carried GHSA-hv8m-jj95-wg3x (NU1903, high severity). Pin forward to the patched 2.5.302. -->
        <PackageVersion Include="MessagePack" Version="2.5.302"/>
        <PackageVersion Include="AspNetCore.SignalR.OpenTelemetry" Version="1.8.0"/>
        <PackageVersion Include="TypedSignalR.Client.Attributes" Version="1.1.0"/>

        <!-- Feature Flags (ADR-0014) — OpenFeature SDK consumed directly by Application layers that read flags -->
        <PackageVersion Include="OpenFeature" Version="2.14.0"/>

        <!-- Health Checks -->
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.8"/>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Common" Version="10.6.0"/>
        <PackageVersion Include="AspNetCore.HealthChecks.Kafka" Version="9.0.0"/>
        <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0"/>
        <PackageVersion Include="AspNetCore.HealthChecks.Uris" Version="9.0.0"/>

        <!-- Invoicing: PDF generation (ADR-0019) + Blob storage (ADR-0017) -->
        <PackageVersion Include="QuestPDF" Version="2026.5.0"/>
        <PackageVersion Include="Azure.Storage.Blobs" Version="12.28.0"/>

        <!-- OpenTelemetry -->
        <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.15.3"/>
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3"/>
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3"/>
        <PackageVersion Include="OpenTelemetry.Extensions.Propagators" Version="1.15.3"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.15.1-beta.1"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.15.1-beta.1"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.15.1-beta.1"/>
        <PackageVersion Include="OpenTelemetry.Resources.Container" Version="1.15.1-beta.1"/>
        <PackageVersion Include="OpenTelemetry.Resources.Host" Version="1.15.1-beta.1"/>

        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556"/>

        <!-- Transitive pins for NU1903 vulnerabilities (closes #139). -->
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.8"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8"/>
    </ItemGroup>
</Project>

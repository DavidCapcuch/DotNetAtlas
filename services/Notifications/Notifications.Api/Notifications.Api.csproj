<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Required on the startup project for `dotnet ef migrations …` (#269). -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- In-app bell SignalR hub transport: server-side MessagePack protocol + OpenTelemetry hub
             instrumentation (#316, ADR-0032). In-memory backplane only — no Redis (ADR-0016). -->
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack"/>
        <PackageReference Include="AspNetCore.SignalR.OpenTelemetry"/>

        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Notifications.Application\Notifications.Application.csproj" />
        <ProjectReference Include="..\Notifications.Infrastructure\Notifications.Infrastructure.csproj" />
        <ProjectReference Include="..\..\..\platform\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Notifications.UnitTests"/>
        <InternalsVisibleTo Include="Notifications.IntegrationTests"/>
        <InternalsVisibleTo Include="Notifications.FunctionalTests"/>
        <InternalsVisibleTo Include="Notifications.ArchitectureTests"/>
    </ItemGroup>

</Project>

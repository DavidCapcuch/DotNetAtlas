{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Kafka": {
    "AvroSerializer": {
      "AutoRegisterSchemas": true
    }
  },
  "Authentication": {
    "JwtBearer": {
      "RequireHttpsMetadata": false
    }
  }
}

{
  // Cross-Cutting Concerns
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "OTEL_SERVICE_NAME": "Notifications",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "ConnectionStrings": {
    "Notifications": "Host=127.0.0.1;Port=5433;Database=Notifications;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true"
  },
  // Inbound JWT bearer for the in-app bell SignalR hub (ADR-0010). Audience pinned explicitly
  // (fail-closed); the platform configurator owns the validation floor (#223).
  "Authentication": {
    "JwtBearer": {
      "Authority": "http://localhost:9011/realms/dotnetatlas",
      "TokenValidationParameters": {
        "ValidAudience": "notifications-service"
      },
      "RequireHttpsMetadata": false
    }
  },
  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  // Communication & Messaging
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    }
  },
  "Topics": {
    "DltTopicSuffix": ".Notifications.DLT",
    "NotifyCommands": "notifications.notify-commands",
    "NotifyEvents": "notifications.notify-events"
  },
  "KafkaNotifyCommandsConsumer": {
    "GroupId": "notifications-group",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest"
  },
  // Email channel — SMTP transport (Mailpit locally, core compose profile). ADR-0032.
  "Smtp": {
    "Host": "127.0.0.1",
    "Port": 1025,
    "FromAddress": "no-reply@dotnetatlas.example",
    "FromName": "DotNetAtlas Notifications"
  },
  // Per-channel dispatch background jobs. ADR-0032.
  "Hangfire": {
    "JobExpirationCheckIntervalMs": 600000,
    "QueuePollIntervalMs": 3000,
    "SchedulePollingIntervalMs": 10000,
    "CancellationCheckIntervalMs": 5000,
    "Queues": [
      "default"
    ]
  },
  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "KafkaTimeout": "00:00:05"
  }
}

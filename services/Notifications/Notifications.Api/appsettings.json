{
  // Cross-Cutting Concerns
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "OTEL_SERVICE_NAME": "NotificationService",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "AllowedHosts": "*",
  // Feature flags (ADR-0014). Opt-in via Platform.ServiceDefaults.AddFeatureFlags(IConfiguration);
  // relative path resolves against the service content root. Wave 0 M7: seed only, opt-in is Wave 1 BC decision.
  "FeatureFlags": {
    "FilePath": "flags.json"
  },
  // Data & Caching
  // Wave 0 M7: Redis:Basket / Redis:Cache / AzureStorage seeded ahead of Wave 1 consumption.
  // - Redis:Basket (ADR-0016): Basket BC primary aggregate store (AOF, noeviction).
  // - Redis:Cache  (ADR-0013 + ADR-0016): ASP.NET OutputCache backing for FastEndpoints .Idempotency()
  //   — read by Platform.ServiceDefaults.AddIdempotencyKeyOutputCache.
  // - AzureStorage (ADR-0017): Azurite dev emulator; Invoicing BC consumes via Azure.Storage.Blobs.
  "ConnectionStrings": {
    "Notifications": "Host=127.0.0.1;Port=5433;Database=Notifications;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true",
    "Redis:Basket": "redis-basket:6379",
    "Redis:Cache": "redis-cache:6379",
    "AzureStorage": "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
  },
  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  // Communication & Messaging
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    },
    "Consumer": {
      "GroupId": "notification-group",
      "BufferSize": 100,
      "WorkersCount": 1,
      "AutoOffsetReset": "Earliest",
      "EnableAutoCommit": false
    }
  },
  "Topics": {
    "NotificationsCommands": "payments.payment-commands",
    "Payments": "payments.payments",
    "DltTopicSuffix": ".Notifications.DLT",
    "EmailCommands": "notifications.email-commands",
    "EmailEvents": "notifications.email-events"
  },
  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "SqlServerTimeout": "00:00:05",
    "KafkaTimeout": "00:00:05"
  }
}

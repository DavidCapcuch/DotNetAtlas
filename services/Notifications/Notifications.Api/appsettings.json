{
  // Cross-Cutting Concerns
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "OTEL_SERVICE_NAME": "Notifications",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "ConnectionStrings": {
    "Notifications": "Host=127.0.0.1;Port=5433;Database=Notifications;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true"
  },
  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  // Communication & Messaging
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    }
  },
  "Topics": {
    "DltTopicSuffix": ".Notifications.DLT",
    "EmailCommands": "notifications.email-commands",
    "EmailEvents": "notifications.email-events"
  },
  "KafkaEmailCommandsConsumer": {
    "GroupId": "notifications-group",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest"
  },
  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "KafkaTimeout": "00:00:05"
  }
}

{
  // Cross-Cutting Concerns
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "OTEL_SERVICE_NAME": "NotificationService",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "AllowedHosts": "*",
  // Data & Caching
  "ConnectionStrings": {
    "Notifications": "Host=127.0.0.1;Port=5433;Database=Notifications;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true"
  },
  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  // Communication & Messaging
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    },
    "Consumer": {
      "GroupId": "notification-group",
      "BufferSize": 100,
      "WorkersCount": 1,
      "AutoOffsetReset": "Earliest",
      "EnableAutoCommit": false
    }
  },
  "Topics": {
    "NotificationsCommands": "payments.payment-commands",
    "Payments": "payments.payments",
    "DltTopicSuffix": ".Notifications.DLT"
  },
  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "SqlServerTimeout": "00:00:05",
    "KafkaTimeout": "00:00:05"
  }
}

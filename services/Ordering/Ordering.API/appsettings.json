{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "KafkaFlow": "Information"
      }
    }
  },
  "OTEL_SERVICE_NAME": "Ordering",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Ordering": "Host=127.0.0.1;Port=5433;Database=Ordering;Username=postgres;Password=PasswordThatShouldBeInVaultAndNotExposed;Include Error Detail=true"
  },
  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    }
  },
  "Topics": {
    "OrderingOrders": "ordering.orders",
    "DltTopicSuffix": ".Ordering.DLT"
  },
  "KafkaOrderCommandsConsumer": {
    "Topic": "ordering.order-commands",
    "GroupId": "ordering-group",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false
  }
}

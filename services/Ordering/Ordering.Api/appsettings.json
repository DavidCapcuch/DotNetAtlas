{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "KafkaFlow": "Information"
      }
    }
  },
  "OTEL_SERVICE_NAME": "Ordering",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "AllowedHosts": "*",
  // Kestrel endpoint binding — canonical config so HTTP_PORTS (set by the chiseled
  // base image) and ASPNETCORE_URLS (removed from Dockerfile/compose) no longer
  // race. Kestrel:Endpoints takes precedence and silences the
  // "Overriding HTTP_PORTS '8080'" startup warning.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  },
  "ConnectionStrings": {
    "Ordering": "Host=127.0.0.1;Port=5433;Database=Ordering;Username=postgres;Password=PasswordThatShouldBeInVaultAndNotExposed;Include Error Detail=true",
    "Redis": {
      "Cache": "localhost:6380,defaultDatabase=0,allowAdmin=true,connectTimeout=2000,syncTimeout=2000,abortConnect=false"
    }
  },
  "Authentication": {
    "JwtBearer": {
      "Authority": "http://localhost:9011/realms/dotnetatlas",
      "RequireHttpsMetadata": false
    }
  },

  "ServiceAuth": {
    "_comment_secret": "Local-dev only. Production overrides via env var KEYCLOAK__SERVICE_CLIENT_SECRET__ordering per ADR-0010.",
    "Authority": "http://localhost:9011/realms/dotnetatlas",
    "ClientId": "ordering-service",
    "ClientSecret": "ClientSecretThatShouldBeInVaultAndNotExposed",
    "ServiceName": "ordering-service"
  },
  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    }
  },
  "Topics": {
    "OrderingOrders": "ordering.orders",
    "DltTopicSuffix": ".Ordering.DLT"
  },
  "KafkaOrderCommandsConsumer": {
    "Topic": "ordering.order-commands",
    "GroupId": "ordering-group",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false
  },
  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "KafkaTimeout": "00:00:05"
  }
}

{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
      }
    }
  },
  "OTEL_SERVICE_NAME": "Catalog",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  // Kestrel:Endpoints wins over HTTP_PORTS from the chiseled base image and silences
  // the "Overriding HTTP_PORTS '8080'" startup warning.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5160",
      "https://localhost:7096"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "Idempotency-Key",
      "X-Correlation-Id"
    ],
    "ExposedHeaders": [],
    "AllowCredentials": true
  },

  "Authentication": {
    "JwtBearer": {
      "Authority": "http://localhost:9011/realms/dotnetatlas",
      "TokenValidationParameters": {
        "ValidAudience": "catalog-service"
      },
      "RequireHttpsMetadata": false
    }
  },

  "ServiceAuth": {
    "_comment_secret": "Local-dev only. Production overrides via env var KEYCLOAK__SERVICE_CLIENT_SECRET__catalog per ADR-0010.",
    "Authority": "http://localhost:9011/realms/dotnetatlas",
    "ClientId": "catalog-service",
    "ClientSecret": "ClientSecretThatShouldBeInVaultAndNotExposed",
    "ServiceName": "catalog-service"
  },

  "ConnectionStrings": {
    "Catalog": "Host=127.0.0.1;Port=5432;Database=Catalog;Username=postgres;Password=PasswordThatShouldBeInVaultAndNotExposed;Include Error Detail=true",
    "Redis:Cache": "localhost:6380,defaultDatabase=0,allowAdmin=true,connectTimeout=2000,syncTimeout=2000,abortConnect=false"
  },

  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },

  "FeatureFlags": {
    "FilePath": "feature-flags.json"
  },

  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    }
  },

  "Topics": {
    "CatalogProducts": "catalog.products",
    "CatalogCategories": "catalog.categories",
    "StockLevelChanged": "inventory.stock-level-changed",
    "DltTopicSuffix": ".Catalog.DLT"
  },

  "KafkaStockLevelChangedConsumer": {
    "GroupId": "catalog-stock-level-watcher",
    "Topic": "inventory.stock-level-changed",
    "BufferSize": 100,
    "WorkersCount": 4,
    "AutoOffsetReset": "Earliest"
  },

  "HealthChecks": {
    "SelfTimeout": "00:00:02",
    "KafkaTimeout": "00:00:05",
    "RedisTimeout": "00:00:04",
    "SchemaRegistryTimeout": "00:00:05"
  }
}

{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "KafkaFlow": "Information"
      }
    }
  },
  "OTEL_SERVICE_NAME": "Invoicing",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "ConnectionStrings": {
    "Invoicing": "Host=127.0.0.1;Port=5433;Database=Invoicing;Username=postgres;Password=LocalDockerPasswordOnlyAiPlsDontFlagThisTy123*!;Include Error Detail=true",
    "Redis:Cache": "localhost:6380,defaultDatabase=0,allowAdmin=true,connectTimeout=2000,syncTimeout=2000,abortConnect=false",
    "AzureStorage": "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
  },
  "Authentication": {
    "JwtBearer": {
      "_comment_deployed": "Base ships no JWT Authority so this edge is deployment-shaped: the dev-only http://localhost Keycloak Authority lives in appsettings.Development.json and appsettings.Testing.json, and a deployed host that sets no Authority fails closed at boot via the platform AssertDeployedAuthorityConfigured guard. RequireHttpsMetadata stays true so deployed environments trust only https:// OIDC metadata; see ADR-0009 item 10.",
      "TokenValidationParameters": {
        "ValidAudience": "invoicing-service"
      },
      "RequireHttpsMetadata": true
    },
    "SwaggerClient": {
      "ClientId": "dotnetatlas-swagger"
    }
  },
  "BlobStorage": {
    "InvoicesContainerName": "invoices"
  },
  "PdfGeneration": {
    "LegalEntityName": "DotNetAtlas Reference s.r.o.",
    "LegalFooter": "VAT ID CZ00000000 | Registered office: Wenceslas Square 1, 11000 Prague, Czechia"
  },
  "EfCore": {
    "UseQuerySplitting": true,
    "RetryMaxCount": 6,
    "RetryMaxDelaySeconds": 30,
    "EnableDetailedErrors": true
  },
  "Kafka": {
    "Brokers": [
      "localhost:9094"
    ],
    "SchemaRegistry": {
      "Url": "http://localhost:8081"
    },
    "AvroSerializer": {
      "SubjectNameStrategy": "Record",
      "AutoRegisterSchemas": false,
      "NormalizeSchemas": true
    }
  },
  "BuyerPortal": {
    "BaseUrl": "https://invoicing.example.com"
  },
  "Topics": {
    "Invoices": "invoicing.invoices",
    "OrderingOrders": "ordering.orders",
    "PaymentsTransactions": "payments.transactions",
    "NotificationsNotifyCommands": "notifications.notify-commands",
    "NotificationsNotifyEvents": "notifications.notify-events",
    "DltTopicSuffix": ".Invoicing.DLT"
  },
  "KafkaOrderingOrdersConsumer": {
    "GroupId": "invoicing-group",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest"
  },
  "KafkaPaymentsTransactionsConsumer": {
    "GroupId": "invoicing-group",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest"
  },
  "KafkaNotificationsNotifyEventsConsumer": {
    "GroupId": "invoicing-group",
    "BufferSize": 100,
    "WorkersCount": 1,
    "AutoOffsetReset": "Earliest"
  },
  "HealthChecks": {
    "DbTimeout": "00:00:02",
    "KafkaTimeout": "00:00:04",
    "RedisTimeout": "00:00:01"
  }
}

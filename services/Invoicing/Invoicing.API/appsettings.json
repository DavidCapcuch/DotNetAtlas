{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "KafkaFlow": "Information"
            }
        }
    },
    "OTEL_SERVICE_NAME": "Invoicing",
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "Invoicing": "Host=127.0.0.1;Port=5434;Database=Invoicing;Username=postgres;Password=PasswordThatShouldBeInVaultAndNotExposed;Include Error Detail=true",
        "Redis": {
            "Cache": "localhost:6380,defaultDatabase=0,allowAdmin=true,connectTimeout=2000,syncTimeout=2000,abortConnect=false"
        },
        "AzureStorage": "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
    },
    "Authentication": {
        "JwtBearer": {
            "Authority": "http://localhost:9011/realms/dotnetatlas",
            "TokenValidationParameters": {
                "ValidateIssuer": true,
                "ValidIssuer": "http://localhost:9011/realms/dotnetatlas",
                "ValidateAudience": true,
                "ValidAudience": "invoicing-service",
                "ValidateIssuerSigningKey": true,
                "RequireSignedTokens": true,
                "ValidateLifetime": true
            },
            "RequireHttpsMetadata": false
        }
    },
    "BlobStorage": {
        "InvoicesContainerName": "invoices"
    },
    "PdfGeneration": {
        "LegalEntityName": "DotNetAtlas Reference s.r.o.",
        "LegalFooter": "VAT ID CZ00000000 | Registered office: Wenceslas Square 1, 11000 Prague, Czechia"
    },
    "EfCore": {
        "UseQuerySplitting": true,
        "RetryMaxCount": 6,
        "RetryMaxDelaySeconds": 30,
        "EnableDetailedErrors": true
    },
    "Kafka": {
        "Brokers": [
            "localhost:9094"
        ],
        "SchemaRegistry": {
            "Url": "http://localhost:8081"
        },
        "AvroSerializer": {
            "SubjectNameStrategy": "Record",
            "AutoRegisterSchemas": false,
            "NormalizeSchemas": true
        }
    },
    "BuyerPortal": {
        "BaseUrl": "https://invoicing.example.com"
    },
    "InvoicingTopics": {
        "Invoices": "invoicing.invoices",
        "OrderingOrders": "ordering.orders",
        "PaymentsTransactions": "payments.transactions",
        "NotificationsEmailCommands": "notifications.email-commands",
        "NotificationsEmailEvents": "notifications.email-events",
        "DltTopicSuffix": ".Invoicing.DLT"
    },
    "KafkaOrderingOrdersConsumer": {
        "Topic": "ordering.orders",
        "GroupId": "invoicing-ordering-projection",
        "BufferSize": 100,
        "WorkersCount": 1,
        "AutoOffsetReset": "Earliest",
        "EnableAutoCommit": false
    },
    "KafkaPaymentsTransactionsConsumer": {
        "Topic": "payments.transactions",
        "GroupId": "invoicing-payments-projection",
        "BufferSize": 100,
        "WorkersCount": 1,
        "AutoOffsetReset": "Earliest",
        "EnableAutoCommit": false
    }
}

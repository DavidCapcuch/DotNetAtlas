<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>All</AnalysisMode>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <!-- Only linux-x64 ships (every image is linux/amd64, published `-r linux-x64`). Portable
             native assets (e.g. librdkafka) still deploy from their packages regardless of this
             list, so local Windows dev is unaffected; listing win-x64 only made the R2R restore
             pull ~175 MB of unused win-x64 framework runtime packs into each image. -->
        <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

        <!-- For GitVersion-->
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <InformationalVersion>$(Version)</InformationalVersion>

        <!-- Ownership — flows into assembly metadata via GenerateAssemblyInfo.
             Static year keeps the build reproducible (no DateTime.Now). -->
        <Company>David Čapčuch</Company>
        <Product>DotNetAtlas</Product>
        <Copyright>© 2026 David Čapčuch</Copyright>

        <!-- Reproducible / debuggable symbols: PDB embedded in the assembly so stack
             traces keep line numbers in Seq, and untracked/generated sources are embedded. -->
        <DebugType>embedded</DebugType>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <!-- Deterministic source paths on CI only (keeps local debugging convenient).
         Normalizes paths so PDBs don't embed the build machine's absolute path. -->
    <PropertyGroup Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>
